		{"id":"11b917246cd129d3","type":"text","text":"# Spark deployment topology\n\n```mermaid\n%%{init: {\"class\": {\"hideEmptyMembersBox\": true}}}%%\nclassDiagram\ndirection LR\n\nclass SparkApplication\nclass Driver\nclass ClusterManager\nclass WorkerNode\nclass Executor\nclass Task\n\nSparkApplication \"1\" *-- \"1\" Driver\nSparkApplication \"1\" --> \"0..*\" Executor : receives\nClusterManager \"1\" --> \"0..*\" Executor : allocates\nWorkerNode \"1\" o-- \"0..*\" Executor : hosts\nExecutor \"1\" --> \"0..*\" Task : executes over time\nDriver --> ClusterManager : requests resources\nDriver --> Task : schedules\n```o0--","x":273,"y":2100,"width":716,"height":240},
