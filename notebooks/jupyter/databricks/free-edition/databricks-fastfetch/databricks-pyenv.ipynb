n\",\r\n    \"\\n\",\r\n    \"                if result.stderr.strip():\\n\",\r\n    \"                    output_parts.append(\\n\",\r\n    \"                        f\\\"stderr:\\\\n{result.stderr.rstrip()}\\\"\\n\",\r\n    \"                    )\\n\",\r\n    \"\\n\",\r\n    \"                if result.returncode != 0:\\n\",\r\n    \"                    output_parts.append(\\n\",\r\n    \"                        f\\\"exit code: {result.returncode}\\\"\\n\",\r\n    \"                    )\\n\",\r\n    \"\\n\",\r\n    \"                command_result = \\\"\\\\n\\\\n\\\".join(output_parts) or \\\"(no output)\\\"\\n\",\r\n    \"\\n\",\r\n    \"            except subprocess.TimeoutExpired:\\n\",\r\n    \"                command_result = (\\n\",\r\n    \"                    f\\\"Command timed out after {command_timeout} seconds\\\"\\n\",\r\n    \"                )\\n\",\r\n    \"\\n\",\r\n    \"            except Exception as exception:\\n\",\r\n    \"                command_result = (\\n\",\r\n    \"                    f\\\"{type(exception).__name__}: {exception}\\\"\\n\",\r\n    \"                )\\n\",\r\n    \"\\n\",\r\n    \"            formatted_result = (\\n\",\r\n    \"                \\\"<pre style='\\\"\\n\",\r\n    \"                \\\"margin: 0;\\\"\\n\",\r\n    \"                \\\"white-space: pre-wrap;\\\"\\n\",\r\n    \"                \\\"overflow-wrap: anywhere;\\\"\\n\",\r\n    \"                \\\"font-size: 12px;\\\"\\n\",\r\n    \"                \\\"'>\\\"\\n\",\r\n    \"                f\\\"{escape(command_result)}\\\"\\n\",\r\n    \"                \\\"</pre>\\\"\\n\",\r\n    \"            )\\n\",\r\n    \"\\n\",\r\n    \"        rows.append(\\n\",\r\n    \"            \\\"<tr>\\\"\\n\",\r\n    \"            f\\\"<td><strong>{escape(variable_name)}</strong></td>\\\"\\n\",\r\n    \"            f\\\"<td>{formatted_value}</td>\\\"\\n\",\r\n    \"            f\\\"<td>{formatted_command}</td>\\\"\\n\",\r\n    \"            f\\\"<td>{formatted_r