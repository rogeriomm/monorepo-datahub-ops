,\r\n   \"outputs\": [],\r\n   \"source\": [\r\n    \"!ps -efww\"\r\n   ]\r\n  },\r\n  {\r\n   \"cell_type\": \"markdown\",\r\n   \"metadata\": {\r\n    \"application/vnd.databricks.v1+cell\": {\r\n     \"cellMetadata\": {},\r\n     \"inputWidgets\": {},\r\n     \"nuid\": \"08f59245-9e51-4dae-a392-bc59492fe7f1\",\r\n     \"showTitle\": false,\r\n     \"tableResultSettingsMap\": {},\r\n     \"title\": \"\"\r\n    }\r\n   },\r\n   \"source\": [\r\n    \"# Databricks notebook Python process\\n\",\r\n    \"\\n\",\r\n    \"The process is started through `sudo`, preserving a large set of environment variables and then switching to a sandboxed Spark user.\\n\",\r\n    \"\\n\",\r\n    \"## Command structure\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"sudo\\n\",\r\n    \"└── preserve selected environment variables\\n\",\r\n    \"    └── run as user: spark-be603da9-a997-4a11-b246-af\\n\",\r\n    \"        └── set environment variable:\\n\",\r\n    \"            DATABRICKS_RUNTIME_VERSION=client.5.9\\n\",\r\n    \"            └── execute sandbox setup:\\n\",\r\n    \"                /databricks/python_shell/scripts/sandbox_env_setup.sh\\n\",\r\n    \"                └── start notebook-scoped Python:\\n\",\r\n    \"                    /local_disk0/.ephemeral_nfs/envs/pythonEnv-be603da9-a997-4a11-b246-aff71ba92b0b/python_start_notebook_scoped.sh\\n\",\r\n    \"                    └── launch Python interpreter:\\n\",\r\n    \"                        /local_disk0/.ephemeral_nfs/envs/pythonEnv-be603da9-a997-4a11-b246-aff71ba92b0b/bin/python\\n\",\r\n    \"                        └── launch Jupyter kernel:\\n\",\r\n    \"                            /databricks/python_shell/scripts/db_ipykernel_launcher.py\\n\",\r\n    \"                            └── use connection file:\\n\",\r\n    \"                                /local_disk0/sandboxapi/5434141154978540186_1/connection.json\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"## Simplified command\\n\",\r\n    \"\\n\",\r\n    \"```bash\\n\",\r\n    \"sudo \\\\\\n\",\r\n    \"  --preserve-env=<environment-variable-list> \\\\\\n\",\r\n    \"  -u spark-be603da9-a997-4a11-b246-af \\\\\\n\",\r\n    \"  env DATABRICKS_RUNTIME_VERSION=client.5.9 \\\\\\n\",\r\n    \"  /databricks/python_shell/scripts/sandbox_env_setup.sh \\\\\\n\",\r\n    \"  /local_disk0/.ephemeral_nfs/envs/pythonEnv-be603da9-a997-4a11-b246-aff71ba92b0b/python_start_notebook_scoped.sh \\\\\\n\",\r\n    \"  /local_disk0/.ephemeral_nfs/envs/pythonEnv-be603da9-a997-4a11-b246-aff71ba92b0b/bin/python \\\\\\n\",\r\n    \"  /databricks/python_shell/scripts/db_ipykernel_launcher.py \\\\\\n\",\r\n    \"  -f /local_disk0/sandboxapi/5434141154978540186_1/connection.json\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"## Main components\\n\",\r\n    \"\\n\",\r\n    \"| Component | Purpose |\\n\",\r\n    \"|---|---|\\n\",\r\n    \"| `sudo` | Starts the process under another user |\\n\",\r\n    \"| `--preserve-env=...` | Keeps selected environment variables |\\n\",\r\n    \"| `-u spark-be603da9-a997-4a11-b246-af` | Runs the process as the sandbox Spark user |\\n\",\r\n    \"| `env DATABRICKS_RUNTIME_VERSION=client.5.9` | Sets the runtime version for the child process |\\n\",\r\n    \"| `sandbox_env_setup.sh` | Configures the Databricks sandbox environment |\\n\",\r\n    \"| `python_start_notebook_scoped.sh` | Prepares the notebook-scoped Python environment |\\n\",\r\n    \"| `bin/python` | Notebook virtual-environment Python interpreter |\\n\",\r\n    \"| `db_ipykernel_launcher.py` | Starts the Databricks Jupyter/IPython kernel |\\n\",\r\n    \"| `connection.json` | Defines the Jupyter kernel communication ports and credentials |\\n\",\r\n    \"\\n\",\r\n    \"## Preserved environment variables\\n\",\r\n    \"\\n\",\r\n    \"### Spark\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"SPARK_WARM_UP_CONF_JSON\\n\",\r\n    \"SPARK_WORKER_PORT\\n\",\r\n    \"SPARK_REMOTE\\n\",\r\n    \"SPARK_LOCAL_HOSTNAME\\n\",\r\n    \"SPARK_EXECUTOR_ATTRIBUTE_POD_NAME\\n\",\r\n    \"SPARK_PUBLIC_DNS\\n\",\r\n    \"SPARK_LOCAL_DIRS\\n\",\r\n    \"SPARK_HOME\\n\",\r\n    \"SPARK_LOCAL_IP\\n\",\r\n    \"SPARK_CONF_DIR\\n\",\r\n    \"SPARK_DIST_CLASSPATH\\n\",\r\n    \"SPARK_ENV_LOADED\\n\",\r\n    \"SPARK_SCALA_VERSION\\n\",\r\n    \"SPARK_WORKER_MEMORY\\n\",\r\n    \"SPARK_DRIVER_CHECKPOINT_RESTORE_COMPATIBLE\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"### PySpark and Py4J\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"PYSPARK_PYTHON\\n\",\r\n    \"PYSPARK_GATEWAY_SECRET\\n\",\r\n    \"PYSPARK_GATEWAY_PORT\\n\",\r\n    \"PY4J_CALLBACK_DYNAMIC\\n\",\r\n    \"PINNED_THREAD_MODE\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"### Databricks runtime\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"DATABRICKS_RUNTIME_VERSION\\n\",\r\n    \"_DRIVER_DATABRICKS_RUNTIME_VERSION\\n\",\r\n    \"DATABRICKS_ENV_VERSION\\n\",\r\n    \"DATABRICKS_CPU_ARCH\\n\",\r\n    \"DATABRICKS_GANGLIA_ENABLED\\n\",\r\n    \"DATABRICKS_PIN_SPARK_TO_X86\\n\",\r\n    \"DEFAULT_DATABRICKS_ROOT_VIRTUALENV_ENV\\n\",\r\n    \"DATABRICKS_ROOT_VIRTUALENV_ENV\\n\",\r\n    \"DATABRICKS_LIBS_NFS_ROOT_PATH\\n\",\r\n    \"DATABRICKS_LIBS_NFS_ROOT_DIR\\n\",\r\n    \"DATABRICKS_CLUSTER_LIBS_ROOT_DIR\\n\",\r\n    \"DATABRICKS_CLUSTER_LIBS_PYTHON_ROOT_DIR\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"### Databricks cluster and driver\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"DB_IS_DRIVER\\n\",\r\n    \"DB_DRIVER_IP\\n\",\r\n    \"DB_INSTANCE_TYPE\\n\",\r\n    \"DB_HOME\\n\",\r\n    \"DB_CONF\\n\",\r\n    \"DBLET\\n\",\r\n    \"DBLET_POD_IP\\n\",\r\n    \"CLUSTER_DB_HOME\\n\",\r\n    \"DRIVER_REPL_ID\\n\",\r\n    \"DRIVER_PROCESS_GROUP_ENABLED\\n\",\r\n    \"DRIVER_PID_FILE\\n\",\r\n    \"DRIVER_PGID_FILE\\n\",\r\n    \"DRIVER_JVM_IP_ADDRESS\\n\",\r\n    \"DRIVER_STARTUP_OBSERVABILITY_ENABLED\\n\",\r\n    \"ENABLE_DRIVER_DEVELOPER_MODE\\n\",\r\n    \"INDEPENDENT_DRIVER_WARM_UP\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"### Kubernetes and pod information\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"POD_NAME\\n\",\r\n    \"POD_NAMESPACE\\n\",\r\n    \"POD_HOSTNAME\\n\",\r\n    \"POD_UID\\n\",\r\n    \"POD_IP\\n\",\r\n    \"HOST_IP\\n\",\r\n    \"HOSTNAME\\n\",\r\n    \"NAMESPACE\\n\",\r\n    \"ORG_ID\\n\",\r\n    \"UNP_NODE_ID\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"### Python\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"PYTHONHASHSEED\\n\",\r\n    \"PYTHONPATH\\n\",\r\n    \"PYTHON_REPL_SAFE_CONFIG_MAP\\n\",\r\n    \"PYDEVD_INTERRUPT_THREAD_TIMEOUT\\n\",\r\n    \"PYDEVD_DISABLE_FILE_VALIDATION\\n\",\r\n    \"_PIP_USE_IMPORTLIB_METADATA\\n\",\r\n    \"PIP_NO_INPUT\\n\",\r\n    \"PYARROW_IGNORE_TIMEZONE\\n\",\r\n    \"MPLBACKEND\\n\",\r\n    \"PYENV_ROOT\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"### Virtual environment and sandbox\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"VIRTUAL_ENV\\n\",\r\n    \"VIRTUAL_ENV_PROMPT\\n\",\r\n    \"SANDBOX_PYTHON_USER\\n\",\r\n    \"SANDBOX_VENV_DIR\\n\",\r\n    \"SANDBOX_STDOUT_LOG\\n\",\r\n    \"SANDBOX_STDERR_LOG\\n\",\r\n    \"SANDBOX_UV_ENABLED\\n\",\r\n    \"IS_SANDBOXED_REPL\\n\",\r\n    \"IS_CLIENT_IMAGE\\n\",\r\n    \"IS_SERVERLESS\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"### MLflow\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"MLFLOW_PYTHON_EXECUTABLE\\n\",\r\n    \"MLFLOW_TRACKING_URI\\n\",\r\n    \"MLFLOW_CONDA_HOME\\n\",\r\n    \"MLFLOW_DEPLOYMENTS_TARGET\\n\",\r\n    \"MLFLOW_GATEWAY_URI\\n\",\r\n    \"MLFLOW_USE_DATABRICKS_SDK_MODEL_ARTIFACTS_REPO_FOR_UC\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"### Java, Scala and native libraries\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"JAVA_HOME\\n\",\r\n    \"JAVA_OPTS\\n\",\r\n    \"SCALA_VERSION\\n\",\r\n    \"CLASSPATH\\n\",\r\n    \"HIVE_HOME\\n\",\r\n    \"ICU_DATA\\n\",\r\n    \"DNNL_DEFAULT_FPMATH_MODE\\n\",\r\n    \"OMP_PLACES\\n\",\r\n    \"OMP_PROC_BIND\\n\",\r\n    \"OMPI_MCA_btl_tcp_if_include\\n\",\r\n    \"OPENSSL_FORCE_FIPS_MODE\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"### Gateway and networking\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"GATEWAY_PORT_READY_FILE_PATH\\n\",\r\n    \"GATEWAY_PORT_FILE_PATH\\n\",\r\n    \"GRPC_GATEWAY_TOKEN\\n\",\r\n    \"PIPELINE_UDS_CONNECT_MODE\\n\",\r\n    \"ENABLE_IPTABLES\\n\",\r\n    \"ENABLE_KEEPALIVE_COMMAND_CONTEXT\\n\",\r\n    \"INSTALL_PROXY_CERTS\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"### Shell and operating-system environment\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"SHELL\\n\",\r\n    \"PATH\\n\",\r\n    \"PWD\\n\",\r\n    \"HOME\\n\",\r\n    \"USER\\n\",\r\n    \"USERNAME\\n\",\r\n    \"LOGNAME\\n\",\r\n    \"LANG\\n\",\r\n    \"LANGUAGE\\n\",\r\n    \"LC_ALL\\n\",\r\n    \"TERM\\n\",\r\n    \"TZ\\n\",\r\n    \"SHLVL\\n\",\r\n    \"SUDO_USER\\n\",\r\n    \"SUDO_UID\\n\",\r\n    \"SUDO_GID\\n\",\r\n    \"SUDO_COMMAND\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"### Logging, monitoring and diagnostics\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"ENABLE_REPL_LOGGING\\n\",\r\n    \"ENABLE_CLASSLOADING_LOGS\\n\",\r\n    \"ENABLE_TRACEPARENT_REPL_PROPAGATION\\n\",\r\n    \"DISABLE_SPARK_MASTER_MONIT\\n\",\r\n    \"EXIT_CODE_FILE_PATH\\n\",\r\n    \"LRU_CACHE_CAPACITY\\n\",\r\n    \"JUPYTER_WIDGETS_ECHO\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"### Other Databricks features\\n\",\r\n    \"\\n\",\r\n    \"```text\\n\",\r\n    \"ENABLE_APPCDS\\n\",\r\n    \"DISABLE_LOCAL_FILESYSTEM\\n\",\r\n    \"DATA_SECURITY_MODE\\n\",\r\n    \"GIT_CONFIG_GLOBAL\\n\",\r\n    \"KOALAS_USAGE_LOGGER\\n\",\r\n    \"CHAUFFEUR_HEAP_SIZE\\n\",\r\n    \"THP_MEM_ALLOC_ENABLE\\n\",\r\n    \"GCP_ENV\\n\",\r\n    \"SIMBASPARKINI\\n\",\r\n    \"DEPLOYMENT_MODE\\n\",\r\n    \"RUNTIME\\n\",\r\n    \"```\\n\",\r\n    \"\\n\",\r\n    \"## Important observation\\n\",\r\n    \"\\n\",\r\n    \"The value following `SPARK_WARM_UP_CONF_JSON` appears to contain embedded JSON:\\n\",\r\n    \"\