    {
      "text": "%spark.ipyspark\ndef get_num_executors(spark):\n  \"\"\"\n  Gets the number of active Spark executors (workers).\n\n  Args:\n    spark:  The SparkSession object.\n\n  Returns:\n    The number of active executors (excluding the driver).\n  \"\"\"\n\n  num_executors \u003d int(sc._conf.get(\"spark.executor.instances\"))\n  if num_executors \u003e 0:\n    return num_executors  #Explicitly set by user\n  else:\n    return len(sc._jsc.sc().getExecutorMemoryStatus()) - 1 #Implicitly inferred by cluster\n\nworkers \u003d get_num_executors(spark)\nprint(\"Spark workers: \", workers)",
