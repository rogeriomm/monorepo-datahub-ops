    {
      "text": "%spark.ipyspark\n\nfrom pyspark.sql.functions import spark_partition_id\n\n# Create a sample DataFrame with some data\ndata \u003d [(\"Alice\", 25), (\"Bob\", 30), (\"Charlie\", 28), (\"David\", 35), (\"Eve\", 22)]\ncolumns \u003d [\"Name\", \"Age\"]\ndf \u003d spark.createDataFrame(data, columns)\ndf \u003d df.withColumn(\"partition_id\", spark_partition_id())\n\n# Check the number of partitions *before* repartitioning\nprint(f\"Number of partitions before repartitioning: {df.rdd.getNumPartitions()}\")\n\n# Display the data\ndf.show()\n\n# Repartition the DataFrame to 3 partitions\nrepartitioned_df \u003d df.repartition(2)\n\n# Add a column with the partition ID\nrepartitioned_df \u003d repartitioned_df.withColumn(\"partition_id\", spark_partition_id())\n\n# Check the number of partitions *after* repartitioning\nprint(f\"Number of partitions after repartitioning: {repartitioned_df.rdd.getNumPartitions()}\")\n\n# Repartitioned DataFrame\nrepartitioned_df.show()\n\n# Repartition using specific columns (equal to groupBy + aggregate)\nrepartitioned_df_by_name \u003d df.repartition(\"Name\")\nprint(f\"Number of partitions after repartitioning by name: {repartitioned_df_by_name.rdd.getNumPartitions()}\")\nrepartitioned_df_by_name.show()",
      "user": "anonymous",
