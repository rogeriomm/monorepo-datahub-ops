    {
      "title": "Bokeh Example (1)",
      "text": "%python.ipython\n\nfrom bokeh.io import output_notebook, show\nfrom bokeh.plotting import figure\n\noutput_notebook()\n\nfig \u003d figure()\nfig.line([1,2], [3,4])\nshow(fig)\n\n",
