COMPOSE_PROFILES=zeppelin_0_12_1,deepseek_harness,jupyter_spark_3_5,jupyter_spark_4_1,jupyter_spark_4_2,jupyter_spark_glue_5,localstack,kafka,obsidian_mcp,pgadmin,postgres,s3,trino
KAFKA_TLS_STORE_PASSWORD=changeit
KAFKA_HOSTNAME=localhost

TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8444
# Optional DNS hostname routed to the Traefik dashboard in addition to traefik.localhost.
TRAEFIK_ADDITIONAL_HOSTNAME=
# Loopback-only Traefik entrypoint for MCP servers that use bearer auth.
TRAEFIK_MCP_PORT=8000
# Use 0.0.0.0 only when HTTPS must accept connections on every interface.
TRAEFIK_HTTPS_BIND=127.0.0.1
# Basic authentication applied to every HTTP and HTTPS route.
TRAEFIK_BASIC_AUTH_USERNAME=admin
TRAEFIK_BASIC_AUTH_PASSWORD=changeit

# Optional DNS hostname routed to jupyter-spark-4.1 in addition to its localhost name.
JUPYTER_SPARK_4_1_ADDITIONAL_HOSTNAME=

# Optional DNS hostnames routed to the corresponding service in addition to its localhost name.
PGADMIN_ADDITIONAL_HOSTNAME=
AIRFLOW_3_3_ADDITIONAL_HOSTNAME=
KAFKA_UI_ADDITIONAL_HOSTNAME=
SUPERSET_ADDITIONAL_HOSTNAME=
TRINO_ADDITIONAL_HOSTNAME=
ZEPPELIN_ADDITIONAL_HOSTNAME=

DSH_VERSION=0.1.6-alpha.1
DSH_IMAGE_VERSION=0.1.6-alpha.1-r1
DSH_DESKTOP_PORT=6080
# Named volume by default. Set an explicit host path only when the Agent should edit it.
DSH_WORKSPACE=deepseek-harness-workspace

TRINO_HOSTNAME=localhost
TRINO_PORT=8443
# Use 0.0.0.0 only when the HTTPS endpoint must accept remote connections.
TRINO_BIND_ADDRESS=127.0.0.1
TRINO_TLS_STORE_PASSWORD=changeit
TRINO_CLIENT_NAME=trino-client
TRINO_CLIENT_STORE_PASSWORD=changeit
# Fail the Airflow Trino monitor at or above this queued-query count.
TRINO_QUEUED_QUERIES_MAX=10

POSTGRES_PORT=5432
# Use a specific host IP to expose PostgreSQL on only one network interface.
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOSTNAME=localhost
POSTGRES_CLIENT_STORE_PASSWORD=changeit
# Fail the Airflow PostgreSQL monitor at or above this connection usage.
POSTGRES_CONNECTION_USAGE_MAX_PERCENT=90
# true requires a client certificate; false uses password authentication over TLS.
POSTGRES_MTLS_ENABLED=true

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Obsidian MCP RAG
# Generate both secrets with: openssl rand -hex 32
OBSIDIAN_MCP_POSTGRES_PASSWORD=replace-with-a-random-hex-value
# Set this to the URL-encoded form of the database password. Hexadecimal
# passwords are already URL-safe, so both values are identical in that case.
OBSIDIAN_MCP_POSTGRES_PASSWORD_URLENCODED=replace-with-a-random-hex-value
OBSIDIAN_MCP_SECRET_KEY=replace-with-a-different-random-hex-value
OBSIDIAN_VAULT_PATH=../../docs
OBSIDIAN_MCP_BASE_URL=http://localhost:8000
OBSIDIAN_MCP_ALLOWED_ORIGINS=["http://localhost:8000","http://obsidian-mcp:8000"]
OBSIDIAN_MCP_ALLOWED_HOSTS=["localhost","127.0.0.1","obsidian-mcp"]
OBSIDIAN_MCP_EMBEDDING_MODEL=bge-m3
OBSIDIAN_MCP_OLLAMA_KEEP_ALIVE=-1
OBSIDIAN_MCP_INDEX_INTERVAL_SECONDS=300
OBSIDIAN_MCP_FTS_CONFIGS=simple

# The postgres (or cdc) profile also starts Kafka and Debezium CDC.
DEBEZIUM_PORT=8083
DEBEZIUM_SCHEMA=public
DEBEZIUM_TOPIC_PREFIX=postgres

# Public key allowed to connect to the ssh-tunnel service.
SSH_TUNNEL_PUBLIC_KEY="ssh-ed25519 AAAA... user@host"

GITHUB_TOKEN=xxx

LOCALSTACK_AUTH_TOKEN="xxx"

AWS_ACCESS_KEY_ID="xxx"
AWS_SECRET_ACCESS_KEY="xxx"
AWS_SESSION_TOKEN="xxx"
AWS_REGION="xxx"

# HOST UID/GID
HOST_UID=1000
HOST_GID=1000
